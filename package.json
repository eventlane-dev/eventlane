{
  "name": "eventlane-monorepo",
  "private": true,
  "description": "EventLane: a persistent event bus on Redis Streams for Node.js and NestJS",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "redis:up": "docker compose up -d eventlane-redis",
    "redis:down": "docker compose down",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/build-llms.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "22",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  }
}
