{
  "name": "@eventlane/board-express",
  "version": "0.1.1",
  "description": "EventLane board: mounts the dashboard (API and UI) into an Express app",
  "keywords": [
    "admin",
    "dashboard",
    "event-bus",
    "eventlane",
    "events",
    "express",
    "monitoring",
    "nodejs",
    "redis",
    "redis-streams",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eventlane-dev/eventlane.git",
    "directory": "packages/board-express"
  },
  "homepage": "https://eventlane-dev.github.io/eventlane/",
  "bugs": {
    "url": "https://github.com/eventlane-dev/eventlane/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eventlane/board-api": "workspace:*",
    "@eventlane/board-ui": "workspace:*"
  },
  "peerDependencies": {
    "@eventlane/core": "workspace:*",
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@eventlane/core": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "ioredis": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
