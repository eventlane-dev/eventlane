{
  "name": "@eventlane/board-nestjs",
  "version": "0.1.0",
  "private": true,
  "description": "EventLane board: mounts the dashboard into a NestJS app (Express or Fastify platform)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eventlane-dev/eventlane.git",
    "directory": "packages/board-nestjs"
  },
  "homepage": "https://eventlane-dev.github.io/eventlane/",
  "bugs": {
    "url": "https://github.com/eventlane-dev/eventlane/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eventlane/board-api": "workspace:*"
  },
  "peerDependencies": {
    "@eventlane/board-express": "workspace:*",
    "@eventlane/board-fastify": "workspace:*",
    "@eventlane/core": "workspace:*",
    "@eventlane/nestjs": "workspace:*",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@eventlane/board-express": {
      "optional": true
    },
    "@eventlane/board-fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eventlane/board-express": "workspace:*",
    "@eventlane/board-fastify": "workspace:*",
    "@eventlane/core": "workspace:*",
    "@eventlane/nestjs": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unplugin-swc": "^2.0.0"
  }
}
