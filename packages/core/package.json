{
  "name": "@eventlane/core",
  "version": "0.1.0",
  "private": true,
  "description": "EventLane core: framework-agnostic persistent event bus on Redis Streams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eventlane-dev/eventlane.git",
    "directory": "packages/core"
  },
  "homepage": "https://eventlane-dev.github.io/eventlane/",
  "bugs": {
    "url": "https://github.com/eventlane-dev/eventlane/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node bench/throughput.mjs"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "ioredis": "^6.0.0"
  }
}
