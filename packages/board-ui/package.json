{
  "name": "@eventlane/board-ui",
  "version": "0.1.0",
  "description": "EventLane board: the single-page web UI, shipped as static files",
  "keywords": [
    "admin",
    "dashboard",
    "event-bus",
    "eventlane",
    "events",
    "monitoring",
    "nodejs",
    "preact",
    "redis",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eventlane-dev/eventlane.git",
    "directory": "packages/board-ui"
  },
  "homepage": "https://eventlane-dev.github.io/eventlane/",
  "bugs": {
    "url": "https://github.com/eventlane-dev/eventlane/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eventlane/board-api": "workspace:*",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "happy-dom": "^21.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
